            "type": "string"
          },
          "subject": {
            "additionalProperties": true,
            "title": "Subject",
            "type": "object"
          },
          "workload": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Workload",
            "type": "string"
          }
        },
        "required": [
          "workload",
          "subject",
          "context"
        ],
        "title": "DecisionRequest",
        "type": "object"
      },
      "DecisionResponse": {
        "properties": {
          "decision_id": {
            "title": "Decision Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "enforce",
              "shadow"
            ],
