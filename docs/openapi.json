{
  "components": {
    "schemas": {
      "ApprovalIn": {
        "properties": {
          "approve": {
            "title": "Approve",
            "type": "boolean"
          }
        },
        "required": [
          "approve"
        ],
        "title": "ApprovalIn",
        "type": "object"
      },
      "CallResult": {
        "properties": {
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "status": {
            "enum": [
              "executed",
              "replayed",
              "approval_required",
              "denied",
              "shadow_skipped"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "CallResult",
        "type": "object"
      },
      "Cond": {
        "additionalProperties": false,
        "description": "Exactly one of: a comparison (field, op, value), all, any, or not.",
        "properties": {
          "all": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Cond"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "All"
          },
          "any": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Cond"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Any"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "not": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cond"
              },
              {
                "type": "null"
              }
            ]
          },
          "op": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Op"
          },
          "value": {
            "title": "Value"
          }
        },
        "title": "Cond",
        "type": "object"
      },
      "DecisionRequest": {
        "properties": {
          "context": {
            "additionalProperties": true,
